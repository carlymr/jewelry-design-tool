# Supabase — from your project's Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy fallback (used only if the publishable key var is unset):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# Anthropic — used server-side by the receipt-processing API route
ANTHROPIC_API_KEY=sk-ant-...

# Etsy Open API v3 — server only, for publishing draft listings (GRA-37).
# Keystring and shared secret from etsy.com/developers/your-apps. The shared
# secret also keys the encryption of stored Etsy tokens: rotating it means
# reconnecting the shop.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
